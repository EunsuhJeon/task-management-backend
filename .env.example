# Local defaults live in src/main/resources/application.properties
# Override with environment variables for production / Render.

DATABASE_URL=jdbc:postgresql://localhost:5432/taskdb
DATABASE_USERNAME=taskuser
DATABASE_PASSWORD=taskpass

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_SEED_ENABLED=true
PORT=8080
